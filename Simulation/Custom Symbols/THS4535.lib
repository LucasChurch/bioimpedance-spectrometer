* SUBCIRCUIT BLOCKS for MODELING
.subckt AOL_1 VC+ VC- IOUT+ IOUT-
.param Gain = 1e-4
.param Ipos = .5
.param Ineg = -.5
G1 IOUT+ IOUT- VALUE={LIMIT(Gain*V(VC+,VC-),Ineg,Ipos)}
.ends
*$
*
.subckt AOL_2 VC+ VC- IOUT+ IOUT-
.param Gain = 3.508e1
.param Ipos = 224.707
.param Ineg = -272.517
G1 IOUT+ IOUT- VALUE={LIMIT(Gain*V(VC+,VC-),Ineg,Ipos)}
.ends
*$
.subckt CLAMP_AMP_HI VC+ VC- VIN COM VO+ VO-
.param G=10
* Output G(COM,0) when condition not met
GVoP COM Vo+ Value = {IF(V(VIN,COM)>V(VC+,COM),((V(VIN,COM)-V(VC+,COM))*G),0)}
GVoN COM Vo- Value = {IF(V(VIN,COM)<V(VC-,COM),((V(VC-,COM)-V(VIN,COM))*G),0)}
.ends
*$
*
.subckt CLAMP_AMP_LO VC+ VC- VIN COM VO+ VO-
.param G=1
* Output G(COM,0) when condition not met
GVoP COM Vo+ Value = {IF(V(VIN,COM)>V(VC+,COM),((V(VIN,COM)-V(VC+,COM))*G),0)}
GVoN COM Vo- Value = {IF(V(VIN,COM)<V(VC-,COM),((V(VC-,COM)-V(VIN,COM))*G),0)}
.ends
*$
*
.subckt CLAWn VC+ VC- IOUT+ IOUT-
G1 IOUT+ IOUT- TABLE {(V(VC+,VC-))} =
+(0, 4.00e-6)
+(49.01, 3.59e-4)
+(103.32, 8.60e-4)
+(136.6, 1.30e-3)
+(165.25, 2.43e-3)
.ends
*$
*
.subckt CLAWp VC+ VC- IOUT+ IOUT-
G1 IOUT+ IOUT- TABLE {(V(VC+,VC-))} =
+(0, 3.00e-6)
+(61.27, 4.40e-4)
+(97.86, 7.48e-4)
+(112.271, 8.91e-4)
+(130.22, 1.09e-3)
+(153.11, 1.43e-3)
+(179.51, 2.33e-3)
.ends
*$
*
.subckt CLAW_SRC VC+ VC- IOUT+ IOUT-
.param Gain = 1
.param Ipos = 5.24e-2
.param Ineg = -4.59e-2
G1 IOUT+ IOUT- VALUE={LIMIT(Gain*V(VC+,VC-),Ineg,Ipos)}
.ends
*$
*
.subckt CL_SRC VC+ VC- IOUT+ IOUT-
.param Gain = 1
.param Ipos = 1.05e-1
.param Ineg = -9.19e-2
G1 IOUT+ IOUT- VALUE={LIMIT(Gain*V(VC+,VC-),Ineg,Ipos)}
.ends
*$
*
.subckt ESD_BB ESDn ESDp
.model ESD_SW SW(Ron=50 Roff=1e12 Vt=0.675 Vh=0.025)
S1         ESDn ESDp ESDn ESDp ESD_SW
S2         ESDp ESDn ESDp ESDn ESD_SW
.ends
*$
*
.subckt ESD_IN ESDn ESDp VDD VSS
.model ESD_SW SW(Ron=50 Roff=1e12 Vt=0.475 Vh=0.025)
S1 VDD ESDn ESDn VDD ESD_SW
S2 VDD ESDp ESDp VDD ESD_SW
S3 ESDn VSS VSS ESDn ESD_SW
S4 ESDp VSS VSS ESDp ESD_SW
.ends
*$
*
.subckt ESD_OUT OUT VDD VSS
.model ESD_SW SW(Ron=50 Roff=1e12 Vt=0.475 Vh=0.025)
S1 VDD OUT OUT VDD ESD_SW
S2 OUT VSS VSS OUT ESD_SW
.ends
*$
* FEMT_THS4535 - input current noise in fA/rt-Hz
.subckt FEMT_THS4535 1 2
* Input variables
* Set up 1/f noise
* FLWF = 1/f frequency in Hz
.param FLWF=1e-3
* NLFF = current noise density at 1/f frequency in fA/rt(Hz)
.param NLFF=69
* Set up broadband noise
* NVRF = broadband current noise density in fA/rt(Hz)
.param NVRF=69
* Calculated values
.param GLFF={PWR(FLWF,0.25)*NLFF/1164}
.param RNVF={1.184*PWR(NVRF,2)}
.model DVNF D KF={PWR(FLWF,0.5)/1e11} IS=1.0e-16
* Circuit connections
I1 0 7 10e-3
I2 0 8 10e-3
D1 7 0 DVNF
D2 8 0 DVNF
E1 3 6 7 8 {GLFF}
R1 3 0 1e9
R2 3 0 1e9
R3 3 6 1e9
E2 6 4 5 0 10
R4 5 0 {RNVF}
R5 5 0 {RNVF}
R6 3 4 1e9
R7 4 0 1e9
G1 1 2 3 4 1e-6
.ends
*$
*
.subckt GR_SRC VC+ VC- IOUT+ IOUT-
.param Gain = 1
.param Ipos = 0.189
.param Ineg = -0.189
G1 IOUT+ IOUT- VALUE={LIMIT(Gain*V(VC+,VC-),Ineg,Ipos)}
.ends
*$
*
.subckt IQ_SRC VC+ VC- IOUT+ IOUT-
.param Gain = 1e-3
G1 IOUT+ IOUT- VALUE={IF( (V(VC+,VC-)<=0),0,Gain*V(VC+,VC-) )}
.ends
*$
*
.subckt OL_SENSE 1   2  3  4
* pins          COM SW+ OLN OLP
GSWP 1 2 Value = {IF((V(3,1)>10e-3 | V(4,1)>10e-3),1,0)}
.ends
*$
*
.subckt SW_OL SW_OL MID CAP_L CAP_R
.model OL_SW SW(Ron=1e-3 Roff=1e9 Vt=0.85 Vh=0.05)
S1 CAP_L CAP_R SW_OL MID OL_SW
.ends
*$
*
.subckt SW_OR CLAMP OLN OLP
.model OR_SW SW(Ron=10e-3 Roff=1e9 Vt=0.005 Vh=0.005)
S1 OLP CLAMP CLAMP OLP OR_SW
S2 CLAMP OLN OLN CLAMP OR_SW
.ends
*$
*
.subckt VCM_CLAMP VIN+ VIN- IOUT- IOUT+ VP+ VP-
.param Gain = 1
G1 IOUT+ IOUT- VALUE={LIMIT(Gain*V(VIN+,VIN-),V(VP-,VIN-), V(VP+,VIN-))}
.ends
*$
*
.subckt VNSE 1 2
.param FLW=100
.param NLF=23.16942
.param NVR=4.2536
.param GLF={PWR(FLW,0.25)*NLF/1164}
.param RNV={1.184*PWR(NVR,2)}
.model DVN D KF={PWR(FLW,0.5)/1E11} IS=1.0E-16
* Circuit connections
I1 0 7 10E-3
I2 0 8 10E-3
D1 7 0 DVN
D2 8 0 DVN
E1 3 6 7 8 {GLF}
R1 3 0 1E9
R2 3 0 1E9
R3 3 6 1E9
E2 6 4 5 0 10
R4 5 0 {RNV}
R5 5 0 {RNV}
R6 3 4 1E9
R7 4 0 1E9
E3 1 2 3 4 1
.ends
*$
*
.subckt VOS_DRIFT VOS+ VOS-
.param DC = 4.991e-3
.param POL = 1
.param DRIFT = 0.3e-6
E1 VOS+ VOS- VALUE={DC+POL*DRIFT*(TEMP-27)}
.ends
*$
*
.subckt VOS_VS_VCM V+ V- REF+ REF-
* Positive rail Vos
E1 V+ 1 TABLE {(V(REF+, V-))} =
+(0.35, 450e-6)
+(0.4, 435e-6)
+(0.55, 275e-6)
+(0.65, 150e-6)
+(0.75, 75e-6)
+(0.85, 25e-6)
+(1, 0)
* Negative rail Vos
V1 1 V- 0
.ends
*$
*
.subckt ZO_SRC VC+ VC- IOUT+ IOUT-
.param Gain = 3.350e2
.param Ipos = 120e3
.param Ineg = -120e3
G1 IOUT+ IOUT- VALUE={LIMIT(Gain*V(VC+,VC-),Ineg,Ipos)}
.ends

